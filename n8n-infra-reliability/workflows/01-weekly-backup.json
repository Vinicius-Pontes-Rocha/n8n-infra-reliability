            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Backups com mais de 8 semanas": {
      "main": [
        [
          {
            "node": "Drive pessoal - mandar backup antigo p/ lixeira",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rodar backup agora": {
      "main": [
        [
          {
            "node": "Drive pessoal - procurar pasta Backup n8n",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}